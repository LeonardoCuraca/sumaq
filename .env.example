# ==============================================================================
# SUMAQ IMPORTACIONES - CONFIGURACIÓN DE ENTORNO
# ==============================================================================

# 1. Base de datos Neon PostgreSQL (Vercel Marketplace -> Neon o Neon Console)
DATABASE_URL="postgres://usuario:password@ep-proyecto.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Vercel Blob Storage (Vercel -> Storage -> Blob)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# 3. NextAuth (Auth.js v5)
# Generar una clave segura con: openssl rand -base64 32
AUTH_SECRET="tu-clave-secreta-aleatoria-generada-con-openssl"
NEXTAUTH_URL="https://sumaq.pe"

# 4. Datos de contacto y WhatsApp
NEXT_PUBLIC_WHATSAPP_NUMBER="51957709262"
NEXT_PUBLIC_CONTACT_EMAIL="sumaq.2025import@gmail.com"
NEXT_PUBLIC_SITE_URL="https://sumaq.pe"

# 5. Pasarela de Pagos Mercado Pago (Checkout Pro + Webhooks HMAC-SHA256)
# Obtén tus credenciales en: https://www.mercadopago.com.pe/developers/panel/app
MP_ACCESS_TOKEN="APP_USR-..."
NEXT_PUBLIC_MP_PUBLIC_KEY="APP_USR-..."
MP_WEBHOOK_SECRET="tu-secret-signature-de-webhooks-mercadopago"

# ==============================================================================
# COMANDOS DE INICIALIZACIÓN
# ==============================================================================
# Aplicar migraciones en la base de datos:
#   npm run db:migrate
#
# Cargar el catálogo inicial de productos si la tabla está vacía:
#   npm run db:seed
#
# Crear el usuario administrador inicial:
#   USER_PASSWORD="tuPasswordSegura2026" npm run user:create -- admin@sumaq.pe "Administrador SUMAQ" admin
